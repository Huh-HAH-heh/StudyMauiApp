<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyMauiApp.ShelterMainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Приют — учет животных"
    BackgroundColor="#F4F6F8">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#20252B" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E0E5EA" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="Muted" TargetType="Label">
            <Setter Property="TextColor" Value="#69747F" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#2F80ED" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0" BackgroundColor="#17212B" StrokeThickness="0" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="ПРИЮТ ДЛЯ ЖИВОТНЫХ"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="Информационная система учета"
                           TextColor="#B9C4CE"
                           FontSize="12" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <VerticalStackLayout x:Name="UserInfo" Spacing="1" VerticalOptions="Center">
                        <Label x:Name="CurrentUserLabel"
                               TextColor="White"
                               FontSize="11"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="End"
                               IsVisible="False" />
                        <Label x:Name="CurrentRoleLabel"
                               TextColor="#B9C4CE"
                               FontSize="9"
                               HorizontalTextAlignment="End"
                               IsVisible="False" />
                    </VerticalStackLayout>

                    <Button
                        x:Name="LoginButton"
                        Text="Войти"
                        BackgroundColor="#2F80ED"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="14,7" />

                    <Button Text="Главная"
                            Clicked="OnHomeClicked"
                            BackgroundColor="#2F80ED"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="14,7" />

                    <Button x:Name="RequestsNavButton"
                            Text="Заявки"
                            Clicked="OnRequestsClicked"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            BorderColor="#61707D"
                            BorderWidth="1"
                            CornerRadius="8"
                            Padding="14,7" />

                    <Button x:Name="ReportsNavButton"
                            Text="Отчеты"
                            Clicked="OnReportsClicked"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            BorderColor="#61707D"
                            BorderWidth="1"
                            CornerRadius="8"
                            Padding="14,7"
                            IsVisible="False" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="20,12" Spacing="10">
                <Button x:Name="AddAnimalButton"
                        Text="+ Добавить животное"
                        Style="{StaticResource ToolButton}"
                        Clicked="OnAddAnimalClicked"
                        IsVisible="False" />

                <Button x:Name="RequestButton"
                        Text="Зарегистрировать заявку"
                        Style="{StaticResource ToolButton}"
                        Clicked="OnAddRequestClicked"
                        IsVisible="False" />

                <Button x:Name="VetButton"
                        Text="Ветеринарная запись"
                        Style="{StaticResource ToolButton}"
                        Clicked="OnVetClicked"
                        IsVisible="False" />

                <Button x:Name="ReportsButton"
                        Text="Сформировать отчет"
                        Style="{StaticResource ToolButton}"
                        Clicked="OnReportsClicked"
                        IsVisible="False" />
            </HorizontalStackLayout>
        </ScrollView>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20,4,20,30" Spacing="16">

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="AnimalsCountLabel"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#2F80ED" />
                            <Label Text="Животных в приюте" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="AdoptedCountLabel"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#27AE60" />
                            <Label Text="Отданы в семьи" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="TreatmentCountLabel"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#F2994A" />
                            <Label Text="На лечении" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="WaitingCountLabel"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#9B51E0" />
                            <Label Text="Ожидают семью" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="1.35*,2*" ColumnSpacing="16">

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Поиск и фильтрация" Style="{StaticResource SectionTitle}" />

                            <Label Text="Поиск по кличке или номеру" Style="{StaticResource Muted}" />
                            <SearchBar x:Name="SearchBox"
                                       Placeholder="Например: Белка или A-104"
                                       TextChanged="OnFilterChanged" />

                            <Label Text="Вид животного" Style="{StaticResource Muted}" />
                            <Picker x:Name="SpeciesPicker"
                                    Title="Все виды"
                                    SelectedIndexChanged="OnFilterChanged">
                                <Picker.Items>
                                    <x:String>Все виды</x:String>
                                    <x:String>Собака</x:String>
                                    <x:String>Кошка</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Пол" Style="{StaticResource Muted}" />
                            <Picker x:Name="GenderPicker"
                                    Title="Любой пол"
                                    SelectedIndexChanged="OnFilterChanged">
                                <Picker.Items>
                                    <x:String>Любой пол</x:String>
                                    <x:String>Самка</x:String>
                                    <x:String>Самец</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Порода" Style="{StaticResource Muted}" />
                            <Entry x:Name="BreedBox"
                                   Placeholder="Например: лабрадор"
                                   TextChanged="OnFilterChanged" />

                            <Button Text="Сбросить фильтры"
                                    Clicked="OnResetFiltersClicked"
                                    BackgroundColor="#E9EEF3"
                                    TextColor="#20252B"
                                    CornerRadius="8" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="Питомцы приюта" Style="{StaticResource SectionTitle}" />
                                    <Label x:Name="ResultsLabel" Text="Найдено: 0" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Подробнее"
                                        BackgroundColor="Transparent"
                                        TextColor="#2F80ED"
                                        Clicked="OnDetailsClicked" />
                            </Grid>

                            <CollectionView Grid.Row="1"
                                            x:Name="AnimalsView"
                                            Margin="0,12,0,0"
                                            SelectionMode="Single"
                                            SelectionChanged="OnAnimalSelected">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="12"
                                                BackgroundColor="#F8FAFC"
                                                Stroke="#E3E8ED"
                                                StrokeShape="RoundRectangle 8">
                                            <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                                                <Border WidthRequest="52"
                                                        HeightRequest="52"
                                                        BackgroundColor="#DDEBFA"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 26">
                                                    <Label Text="🐾"
                                                           FontSize="25"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding Name}"
                                                           FontAttributes="Bold"
                                                           FontSize="15" />
                                                    <Label Text="{Binding Number}"
                                                           Style="{StaticResource Muted}" />
                                                    <Label Text="{Binding Details}"
                                                           Style="{StaticResource Muted}" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="2"
                                                                     HorizontalOptions="End"
                                                                     VerticalOptions="Center"
                                                                     Spacing="3">
                                                    <Label Text="{Binding Status}"
                                                           TextColor="#27AE60"
                                                           FontAttributes="Bold"
                                                           FontSize="11" />
                                                    <Label Text="{Binding Weight}"
                                                           Style="{StaticResource Muted}"
                                                           HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Последние заявки" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Взятие в семью — Иванова А." FontSize="13" />
                                <Label Grid.Column="1" Text="02.10.2026" Style="{StaticResource Muted}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E7EBEF" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Сдача животного — Петров И." FontSize="13" />
                                <Label Grid.Column="1" Text="01.10.2026" Style="{StaticResource Muted}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E7EBEF" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Взятие в семью — Смирнова Е." FontSize="13" />
                                <Label Grid.Column="1" Text="30.09.2026" Style="{StaticResource Muted}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Ветеринарные манипуляции" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Вакцинация — Белка" FontSize="13" />
                                <Label Grid.Column="1" Text="Сегодня" Style="{StaticResource Muted}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E7EBEF" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Осмотр — Барсик" FontSize="13" />
                                <Label Grid.Column="1" Text="01.10.2026" Style="{StaticResource Muted}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E7EBEF" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Обработка — Рекс" FontSize="13" />
                                <Label Grid.Column="1" Text="30.09.2026" Style="{StaticResource Muted}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>