<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource DashboardLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource DashboardCard}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BackgroundColor" Value="{StaticResource DashboardCyan}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinimumHeightRequest" Value="30" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Gray900}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray300}" />
        <Setter Property="BackgroundColor" Value="{StaticResource DashboardCard}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="HeightRequest" Value="32" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Gray900}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource DashboardBackground}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource DashboardCard}" />
        <Setter Property="Stroke" Value="{StaticResource DashboardLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource DashboardDark}" />
    </Style>

    <Style x:Key="MutedStyle" TargetType="Label">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="TextColor" Value="{StaticResource DashboardMuted}" />
    </Style>

    <Style x:Key="TinyStyle" TargetType="Label">
        <Setter Property="FontSize" Value="7" />
        <Setter Property="TextColor" Value="{StaticResource DashboardMuted}" />
    </Style>

    <Style x:Key="DarkBarStyle" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource DashboardDark}" />
        <Setter Property="HeightRequest" Value="26" />
    </Style>

    <Style x:Key="CyanBarStyle" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource DashboardCyan}" />
        <Setter Property="HeightRequest" Value="26" />
    </Style>

    <Style x:Key="CardValueStyle" TargetType="Label">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource DashboardDark}" />
    </Style>
</ResourceDictionary>
